# =========================================================
# GIKORA ARCHITECTS — Variables d'environnement
# Copiez ce fichier en `.env.local` pour le développement,
# et ajoutez les mêmes variables dans Vercel :
# Project → Settings → Environment Variables
# =========================================================

# URL publique du site (SEO : sitemap, balises canonical, Open Graph)
# Sans slash final. Ex : https://www.gikoraarchitects.com
NEXT_PUBLIC_SITE_URL=

# Code de vérification Google Search Console (méthode "balise HTML"),
# uniquement la valeur de l'attribut content. Facultatif.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------
# RESEND — envoi des emails des formulaires (Contact + Diaspora)
# ---------------------------------------------------------

# Clé API Resend (obligatoire) : https://resend.com/api-keys
# Permission recommandée : "Sending access" uniquement.
RESEND_API_KEY=

# Adresse(s) qui REÇOIVENT les messages des clients.
# Plusieurs adresses possibles, séparées par des virgules.
CONTACT_EMAIL=gikoragroup@gmail.com

# Expéditeur des emails. Doit utiliser un domaine VÉRIFIÉ dans Resend
# (https://resend.com/domains). Ex : Gikora Architects <contact@gikoraarchitects.com>
# Si vide, "onboarding@resend.dev" est utilisé : Resend n'enverra alors
# les emails QU'À l'adresse du propriétaire du compte Resend.
EMAIL_FROM=

# "true" pour envoyer un accusé de réception automatique au visiteur.
# Fonctionne uniquement avec un domaine vérifié dans EMAIL_FROM.
CONTACT_AUTOREPLY=false
